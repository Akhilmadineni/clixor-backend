# Copy to /volume1/docker/clustr/secrets/production.env and chmod 600.
# Never commit the populated file.
CLUSTER_ENV=production
CLUSTER_HTTP_ADDR=:8080
CLUSTER_PUBLIC_BASE_URL=https://clustr-api.atlanteanz.com
CLUSTER_STORE=postgres
CLUSTER_AUTO_MIGRATE=false

# Production validation requires authenticated, TLS-protected dependencies.
CLUSTER_DATABASE_URL=postgres://clustr:REPLACE_ME@postgres.example.internal:5432/clustr?sslmode=verify-full
CLUSTER_REDIS_URL=rediss://:REPLACE_ME@redis.example.internal:6379/0
CLUSTER_NATS_URL=tls://nats.example.internal:4222
CLUSTER_S3_ENDPOINT=s3.example.internal:443
CLUSTER_S3_ACCESS_KEY=REPLACE_ME
CLUSTER_S3_SECRET_KEY=REPLACE_ME
CLUSTER_S3_BUCKET=clustr-media
CLUSTER_S3_USE_TLS=true

# Generate separate random values of at least 32 bytes.
CLUSTER_JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CLUSTER_METRICS_TOKEN=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
CLUSTER_JWT_ISSUER=clustr-api
CLUSTER_ACCESS_TTL=15m
CLUSTER_REFRESH_TTL=720h

# The API owns the OTP lifecycle; Telnyx transports only the SMS.
CLUSTER_VERIFICATION_PROVIDER=telnyx
CLUSTER_OTP_HMAC_SECRET=REPLACE_WITH_A_DISTINCT_48_BYTE_RANDOM_SECRET
CLUSTER_OTP_CODE_LENGTH=6
CLUSTER_OTP_CHALLENGE_TTL=10m
CLUSTER_OTP_RESEND_COOLDOWN=1m
CLUSTER_OTP_LOCKOUT_TTL=15m
CLUSTER_OTP_MAX_ATTEMPTS=5
CLUSTER_OTP_PHONE_SEND_HOURLY=5
CLUSTER_OTP_PHONE_SEND_DAILY=10
CLUSTER_OTP_GLOBAL_SEND_MINUTE=60
CLUSTER_OTP_GLOBAL_SEND_DAILY=10000
# Optional comma-separated E.164 country prefixes, for example +1,+44.
CLUSTER_OTP_ALLOWED_PREFIXES=+1
CLUSTER_TELNYX_API_KEY=REPLACE_ME
CLUSTER_TELNYX_FROM_NUMBER=+13125550100
CLUSTER_TELNYX_MESSAGING_PROFILE_ID=REPLACE_ME
CLUSTER_TELNYX_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY

CLUSTER_APNS_TEAM_ID=REPLACE_ME
CLUSTER_APNS_KEY_ID=REPLACE_ME
CLUSTER_APNS_BUNDLE_ID=com.Clustr.Clustr.Clustr
CLUSTER_APNS_PRIVATE_KEY_FILE=/run/secrets/apns/AuthKey.p8
CLUSTER_APNS_ENVIRONMENT=production

[Unit]
Description=Prepare Clixor runtime secrets before containers start
After=network-online.target srv-clixor.mount
Wants=network-online.target
RequiresMountsFor=/srv/clixor
Before=docker.service cloudflared.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/clixor/prepare-runtime-secrets.sh
RemainAfterExit=yes
UMask=0077
LimitCORE=0
RuntimeDirectory=clixor
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/run/clixor

[Install]
WantedBy=multi-user.target

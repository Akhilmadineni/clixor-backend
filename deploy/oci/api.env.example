# Reference only. Install as /srv/clixor/secrets/api.env with owner root:root
# and mode 0600. Only api-a and api-b consume this file. Never commit values.

CLUSTER_ENV=production
CLUSTER_HTTP_ADDR=:8080
CLUSTER_HTTP_WRITE_TIMEOUT=135s
CLUSTER_PUBLIC_BASE_URL=https://clustr-api.atlanteanz.com
CLUSTER_TLS_CA_FILE=/run/pki/ca.crt
CLUSTER_STORE=postgres
CLUSTER_AUTO_MIGRATE=false
CLUSTER_TRUSTED_PROXY_CIDRS=172.30.254.2/32
CLUSTER_DATABASE_URL=postgres://clixor:REPLACE_WITH_POSTGRES_PASSWORD@postgres.clixor.internal:5432/clixor?sslmode=verify-full&sslrootcert=/run/pki/ca.crt
CLUSTER_DATABASE_MAX_CONNS=12
CLUSTER_DATABASE_MIN_CONNS=2
CLUSTER_REDIS_URL=rediss://:REPLACE_WITH_REDIS_PASSWORD@clixor-tls:6379/0
CLUSTER_NATS_URL=tls://REPLACE_WITH_NATS_TOKEN@nats.clixor.internal:4222

CLUSTER_JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CLUSTER_METRICS_TOKEN=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
CLUSTER_JWT_ISSUER=clixor-api
CLUSTER_ACCESS_TTL=15m
CLUSTER_REFRESH_TTL=720h
CLUSTER_APPLE_CLIENT_ID=com.Clustr.Clustr.Clustr

# Native OCI media uses the VM instance principal, not a static cloud key.
CLUSTER_MEDIA_PROVIDER=oci
CLUSTER_OCI_OBJECT_STORAGE_NAMESPACE=REPLACE_WITH_TENANCY_OBJECT_STORAGE_NAMESPACE
CLUSTER_OCI_OBJECT_STORAGE_BUCKET=clixor-prod-media
CLUSTER_OCI_OBJECT_STORAGE_REGION=us-phoenix-1

# Keep the production-05b 1 GiB conversation-upload contract explicit. Quotas
# are enforced transactionally across both API replicas before a PAR is issued.
CLUSTER_MEDIA_CONVERSATION_MAX_BYTES=1073741824
CLUSTER_MEDIA_PROFILE_MAX_BYTES=20971520
CLUSTER_MEDIA_COMPLETION_TIMEOUT=2m
CLUSTER_MEDIA_VERIFY_CONCURRENCY=4
CLUSTER_MEDIA_PENDING_TTL=15m
CLUSTER_MEDIA_PENDING_USER_MAX_COUNT=8
CLUSTER_MEDIA_PENDING_USER_MAX_BYTES=2147483648
CLUSTER_MEDIA_PENDING_CONVERSATION_MAX_COUNT=32
CLUSTER_MEDIA_PENDING_CONVERSATION_MAX_BYTES=8589934592
CLUSTER_MEDIA_STORED_USER_MAX_COUNT=2000
CLUSTER_MEDIA_STORED_USER_MAX_BYTES=2147483648
CLUSTER_MEDIA_STORED_CONVERSATION_MAX_COUNT=10000
CLUSTER_MEDIA_STORED_CONVERSATION_MAX_BYTES=10737418240
CLUSTER_MEDIA_CLEANUP_INTERVAL=30s
CLUSTER_MEDIA_CLEANUP_BATCH_SIZE=500

CLUSTER_VERIFICATION_PROVIDER=telnyx
CLUSTER_OTP_HMAC_SECRET=REPLACE_WITH_A_DISTINCT_48_BYTE_RANDOM_SECRET
CLUSTER_OTP_CODE_LENGTH=6
CLUSTER_OTP_CHALLENGE_TTL=10m
CLUSTER_OTP_RESEND_COOLDOWN=1m
CLUSTER_OTP_LOCKOUT_TTL=15m
CLUSTER_OTP_MAX_ATTEMPTS=5
CLUSTER_OTP_PHONE_SEND_HOURLY=5
CLUSTER_OTP_PHONE_SEND_DAILY=10
CLUSTER_OTP_GLOBAL_SEND_MINUTE=60
CLUSTER_OTP_GLOBAL_SEND_DAILY=10000
CLUSTER_OTP_ALLOWED_PREFIXES=+1
CLUSTER_TELNYX_API_KEY=REPLACE_WITH_TELNYX_API_KEY
CLUSTER_TELNYX_FROM_NUMBER=+13125550100
CLUSTER_TELNYX_MESSAGING_PROFILE_ID=REPLACE_WITH_PROFILE_ID
CLUSTER_TELNYX_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY

# OCI Email Delivery supports implicit TLS on 465. Port 587 may instead use
# CLUSTER_SMTP_TRANSPORT=starttls; both modes require authenticated TLS.
CLUSTER_MAIL_PROVIDER=smtp
CLUSTER_SMTP_TRANSPORT=implicit_tls
CLUSTER_SMTP_ADDRESS=smtp.email.us-phoenix-1.oci.oraclecloud.com:465
CLUSTER_SMTP_USERNAME=REPLACE_WITH_OCI_SMTP_USERNAME
CLUSTER_SMTP_PASSWORD=REPLACE_WITH_OCI_SMTP_PASSWORD
CLUSTER_SMTP_SERVER_NAME=smtp.email.us-phoenix-1.oci.oraclecloud.com
CLUSTER_SMTP_CA_FILE=
CLUSTER_MAIL_FROM="Clixor <no-reply@mail.atlanteanz.com>"
CLUSTER_PASSWORD_RESET_HMAC_SECRET=REPLACE_WITH_A_DISTINCT_48_BYTE_RANDOM_SECRET
CLUSTER_MAIL_QUEUE_ENCRYPTION_KEY=REPLACE_WITH_PADDED_BASE64_32_BYTE_RANDOM_KEY
CLUSTER_PASSWORD_RESET_TTL=10m
CLUSTER_PASSWORD_RESET_CODE_LENGTH=8
CLUSTER_PASSWORD_RESET_MAX_ATTEMPTS=5
CLUSTER_MAIL_QUEUE_BATCH_SIZE=50
CLUSTER_MAIL_QUEUE_WORKER_CONCURRENCY=4
CLUSTER_MAIL_QUEUE_MAX_ATTEMPTS=8
CLUSTER_MAIL_QUEUE_RETRY_BASE_DELAY=5s
CLUSTER_MAIL_QUEUE_RETRY_MAX_DELAY=30m
CLUSTER_MAIL_QUEUE_DELIVERED_RETENTION=24h
CLUSTER_MAIL_QUEUE_DEAD_LETTER_RETENTION=720h

CLUSTER_PUSH_DELIVERY_BATCH_SIZE=100
CLUSTER_PUSH_WORKER_CONCURRENCY=16
CLUSTER_PUSH_MAX_ATTEMPTS=8
CLUSTER_PUSH_RETRY_BASE_DELAY=2s
CLUSTER_PUSH_RETRY_MAX_DELAY=15m
CLUSTER_PUSH_DELIVERED_RETENTION=24h
CLUSTER_PUSH_DEAD_LETTER_RETENTION=720h

CLUSTER_APNS_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
CLUSTER_APNS_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
CLUSTER_APNS_BUNDLE_ID=com.Clustr.Clustr.Clustr
CLUSTER_APNS_PRIVATE_KEY_FILE=/run/secrets/apns/AuthKey.p8
CLUSTER_APNS_ENVIRONMENT=production
CLUSTER_APNS_SANDBOX_TEAM_ID=
CLUSTER_APNS_SANDBOX_KEY_ID=
CLUSTER_APNS_SANDBOX_BUNDLE_ID=
CLUSTER_APNS_SANDBOX_PRIVATE_KEY_FILE=

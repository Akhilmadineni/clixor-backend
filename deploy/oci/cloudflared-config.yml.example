# Copy to /etc/cloudflared/config.yml only after creating a locally managed
# tunnel. The tunnel credentials JSON is generated by cloudflared and must stay
# outside the repository with mode 0600.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json
protocol: quic

ingress:
  - hostname: clustr-api.atlanteanz.com
    service: http://172.30.254.2:8080
  - hostname: clixor.atlanteanz.com
    service: http://172.30.254.2:8080
  - service: http_status:404

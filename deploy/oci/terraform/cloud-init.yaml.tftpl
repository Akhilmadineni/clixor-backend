#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - gnupg
  - jq
  - python3
  - ufw
  - unzip
  - xfsprogs

write_files:
  - path: /etc/ssh/sshd_config.d/99-clixor-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      X11Forwarding no
      AllowUsers ubuntu

  - path: /usr/local/sbin/clixor-mount-data
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      device="${data_device}"
      mount_point="/srv/clixor"

      if [[ ! -b "$device" ]]; then
        echo "waiting for Terraform to attach $device" >&2
        exit 1
      fi

      root_device="$(findmnt -n -o SOURCE /)"
      if [[ "$(readlink -f "$device")" == "$(readlink -f "$root_device")" ]]; then
        echo "refusing to format the root filesystem device" >&2
        exit 2
      fi

      filesystem="$(blkid -o value -s TYPE "$device" || true)"
      if [[ -z "$filesystem" ]]; then
        mkfs.xfs -f -L CLIXOR_DATA "$device"
      elif [[ "$filesystem" != "xfs" ]]; then
        echo "refusing unexpected filesystem type: $filesystem" >&2
        exit 3
      fi

      mkdir -p "$mount_point"
      uuid="$(blkid -o value -s UUID "$device")"
      if ! grep -q "UUID=$uuid " /etc/fstab; then
        printf 'UUID=%s %s xfs defaults,nofail,x-systemd.device-timeout=5min 0 2\n' "$uuid" "$mount_point" >> /etc/fstab
      fi
      mount "$mount_point"
      install -d -m 0750 -o root -g docker "$mount_point/app" "$mount_point/data" "$mount_point/backups" "$mount_point/releases"

  - path: /etc/systemd/system/clixor-data-volume.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Validate and mount the Clixor data volume
      Before=docker.service
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/clixor-mount-data
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=15

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/docker.service.d/10-clixor-data.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Requires=clixor-data-volume.service
      After=clixor-data-volume.service
      RequiresMountsFor=/srv/clixor

runcmd:
  - [bash, -lc, "systemctl stop docker.service docker.socket || true"]
  - [bash, -lc, "systemctl daemon-reload"]
  - [bash, -lc, "systemctl enable clixor-data-volume.service docker.service"]
  - [bash, -lc, "ufw default deny incoming"]
  - [bash, -lc, "ufw default allow outgoing"]
  - [bash, -lc, "ufw allow from ${bastion_private_endpoint_cidr} to any port 22 proto tcp"]
  - [bash, -lc, "ufw --force enable"]
  - [bash, -lc, "systemctl restart ssh"]
  - [bash, -lc, "systemctl start clixor-data-volume.service"]
  - [bash, -lc, "systemctl start docker.service"]
  - [bash, -lc, "usermod -aG docker ubuntu"]

final_message: "Clixor OCI host bootstrap finished. Runtime secrets and application deployment are intentionally separate."

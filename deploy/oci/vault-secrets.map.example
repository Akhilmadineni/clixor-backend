# Nonsecret OCI Vault secret OCIDs only. Install the populated mapping as
# /etc/clixor/vault-secrets.map with owner root:root and mode 0600.
# Never put secret values, secret bundle content, passwords, or tokens here.
api_env=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_API_ENV_SECRET_OCID
postgres_env=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_POSTGRES_ENV_SECRET_OCID
redis_env=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_REDIS_ENV_SECRET_OCID
nats_env=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_NATS_ENV_SECRET_OCID
grafana_env=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_GRAFANA_ENV_SECRET_OCID
apns_production_p8=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_APNS_PRODUCTION_SECRET_OCID
# Add this only when api_env enables the sandbox APNs key path.
# apns_sandbox_p8=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_APNS_SANDBOX_SECRET_OCID
cloudflare_token=ocid1.vaultsecret.oc1.us-phoenix-1.REPLACE_WITH_CLOUDFLARE_TOKEN_SECRET_OCID

# Must match the database pool values and URL in api.env. The migration binary
# loads only this database configuration and receives no API/provider secrets.
CLUSTER_DATABASE_URL=postgres://clixor:REPLACE_WITH_POSTGRES_PASSWORD@postgres.clixor.internal:5432/clixor?sslmode=verify-full&sslrootcert=/run/pki/ca.crt
CLUSTER_DATABASE_MAX_CONNS=12
CLUSTER_DATABASE_MIN_CONNS=2
CLUSTER_TLS_CA_FILE=/run/pki/ca.crt
